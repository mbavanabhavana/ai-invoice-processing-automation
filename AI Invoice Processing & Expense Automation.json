    {
      "parameters": {
        "jsCode": "const subtotal = Number($json.subtotal || 0);\nconst cgst = Number($json.cgst || 0);\nconst sgst = Number($json.sgst || 0);\nconst total = Number($json.total_amount || 0);\n\nconst calculatedTotal = subtotal + cgst + sgst;\n\nconst difference = Math.abs(calculatedTotal - total);\n\nconst validationStatus = difference < 0.01\n  ? \"Valid\"\n  : \"Mismatch\";\n\nreturn {\n  json: {\n    ...$json,\n    calculated_total: calculatedTotal,\n    validation_status: validationStatus,\n    difference: difference\n  }\n};"
      },
