          "id": "zGBsfS9vJc2mMdf5",
          "name": "Google Gemini(PaLM) Api account 3"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const text = $json.content.parts[0].text;\n\nconst cleaned = text\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst invoice = JSON.parse(cleaned);\n\nreturn {\n  json: invoice\n};"
      },
